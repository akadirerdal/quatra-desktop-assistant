# QUATRA — Sadece non-secret ayarlar.
# GERÇEK API anahtarları buraya YAZILMAZ: OS şifre kasasında (credentials vault) saklanır.
# Bu dosyayı kopyalayıp .env yapmak için: cp .env.example .env (ama anahtar koyma!)

# Log seviyesi: debug | info | warn | error
QUATRA_LOG_LEVEL=info

# Diagnostics halka tamponunda tutulacak azami kayıt sayısı
QUATRA_DIAGNOSTICS_MAX_ENTRIES=200

# Telemetri (gönderim yok — uygulama içi metrikler için ayrılmış)
QUATRA_TELEMETRY=off
