{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "include": [
    "electron",
    "src/providers",
    "src/features/tools",
    "src/features/agent",
    "src/services/log",
    "src/types",
    "src/utils",
    "src/shared"
  ]
}
